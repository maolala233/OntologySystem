# ==============================================================================
# 后端环境变量模板 —— 复制为 .env 后填写
# 位置必须是 src/backend/.env（app/core/config.py 按 CWD 相对读取，见下注释）
# ==============================================================================
#   正确：cd src/backend && uvicorn main:app --port 3001
#   错误：在项目根跑 uvicorn src.backend.main:app   ← 读不到 .env
#
# ⚠️ 项目根的 .env 只给 docker compose 做变量替换，后端不读它。
# ⚠️ IP 只允许出现在本文件/.env，业务代码一律读环境变量（docs/design/01 §8）。
# ==============================================================================

# ================= 中间件地址（默认在独立主机，端口为宿主映射）=================
HOST_IP=CHANGE_ME_MIDDLEWARE_HOST

# MySQL（注意端口是宿主映射的 3309，不是容器内 3306）
MYSQL_HOST=CHANGE_ME_MIDDLEWARE_HOST
MYSQL_PORT=3309
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=ontology_db

# Neo4j
NEO4J_URI=bolt://CHANGE_ME_MIDDLEWARE_HOST:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Milvus
MILVUS_HOST=CHANGE_ME_MIDDLEWARE_HOST
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=knowledge_graph_rag

# Redis（Celery broker/backend + 任务进度键）
REDIS_URL=redis://CHANGE_ME_MIDDLEWARE_HOST:6379/0

# 业务 MinIO（桶：ontology-uploads / ontology-parsed / ontology-exports）
MINIO_ENDPOINT=CHANGE_ME_MIDDLEWARE_HOST:9010
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false

# ================= JWT =================
JWT_SECRET_KEY=CHANGE_ME_RANDOM_LONG_STRING
# M1：access 2h + refresh 7d（docs/design/01 §8）
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================= 模型服务（M2 起迁入 model_configs 表，此处为兜底）=================
# 任何 OpenAI 兼容端点：远程 API / 内网 vLLM / 云厂商。地址带 /v1。
# ---- 对话 / 抽取模型 ----
VLLM_BASE_URL=http://CHANGE_ME:8000/v1
VLLM_API_KEY=CHANGE_ME
VLLM_MODEL=CHANGE_ME
# ---- 嵌入模型（维度必须与 Milvus collection 一致）----
EMBEDDING_BASE_URL=http://CHANGE_ME:8000/v1
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_MODEL=CHANGE_ME
EMBEDDING_DIM=1024
# ---- 备用 LLM 客户端（不用则留空 API_KEY）----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_NAME=z-ai/glm-4.5-air:free
LLM_THINK_MODE=auto

# ================= M0 新增 =================
# 模型密钥加密主密钥（AES-256-GCM；生产必须设置，开发留空则回退派生自 JWT_SECRET_KEY）
SECRET_MASTER_KEY=
# CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3080,http://127.0.0.1:3080
# 嵌入式 Oxigraph 数据目录（M4 接入）
OXIGRAPH_PATH=./data/oxigraph
# 国内网络预取 Docling OCR 模型（首次解析前可执行 docling-tools models download）
# HF_ENDPOINT=https://hf-mirror.com
