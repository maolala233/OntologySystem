# ====================================
# Graph Injector Service 配置文件
# ====================================

# 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_WORKERS=4
LOG_LEVEL=INFO

# LLM模型配置 (支持 vLLM 或 Ollama)
# vLLM 示例:
#   LLM_BASE_URL=http://localhost:8001/v1
#   LLM_API_KEY=your_vllm_api_key
#   LLM_MODEL=qwen2.5-7b-instruct
#
# Ollama 示例:
#   LLM_BASE_URL=http://localhost:11434
#   LLM_API_KEY=
#   LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096

# Embedding模型配置 (支持 vLLM 或 Ollama)
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3:latest
EMBED_TIMEOUT=30
EMBED_DIM=1024

# Elasticsearch配置
ES_HOST=localhost
ES_PORT=1200
ES_USER=elastic
ES_PASSWORD=infini_rag_flow
ES_USE_SSL=false
ES_VERIFY_CERTS=false

# RAGFlow API配置 (用于知识库注入)
RAGFLOW_API_HOST=http://localhost:9380

# 文件上传配置
MAX_UPLOAD_SIZE_MB=100
TEMP_UPLOAD_DIR=data/temp_uploads
SCHEMA_OUTPUT_DIR=data/schemas
OUTPUT_DIR=data/output

# 文本分块配置
DEFAULT_CHUNK_SIZE=1000
DEFAULT_OVERLAP_PERCENTAGE=10

# 注入配置
ES_INDEX_PREFIX=ragflow
ES_BULK_SIZE=100
